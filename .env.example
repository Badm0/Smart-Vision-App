# ---- Backend (SV_*) ----
# SV_MODEL_PATH=best.pt      # optional override; auto-selects best.engine first, then best.pt
SV_CONF=0.30
SV_IMGSZ=640
SV_DEVICE=                  # empty = auto (CUDA if available)
SV_THREAT_CLASSES=          # comma-separated labels that count as threats; empty = every class
SV_CLAHE=1                  # contrast normalisation; set 0 if your model was trained without it
SV_CLAHE_CLIP=1.5
SV_DENOISE=0
SV_OUTPUT_MAX_SIDE=960
SV_JPEG_QUALITY=80
SV_MAX_STREAM_FPS=30
SV_DETECT_EVERY=1           # run inference every N frames (boxes persist in between)
SV_REALTIME_SYNC=1          # drop stale frames to stay in real time
SV_LOOP_VIDEO=1
SV_CONFIRM_FRAMES=3         # frames a threat must persist before an alert is raised
SV_ALERT_COOLDOWN_S=6
SV_INCIDENT_DIR=incidents   # annotated JPEG evidence for confirmed threat alerts
SV_PANIC_WEBHOOK_URL=       # e.g. a Slack/Teams/incident webhook
SV_CORS_ORIGINS=*
# SV_MOCK_DETECTOR=1        # development only: simulated detections, no weights needed

# ---- Frontend ----
SV_API_URL=http://127.0.0.1:8000          # Streamlit server -> API
SV_PUBLIC_API_URL=http://127.0.0.1:8000   # browser -> API
SV_OPERATOR_NAME=Operator 01
SV_OPERATOR_ROLE=Shift lead
SV_STATION=SOC station 01
